<%- include('partials/header', { title: 'Gestion Admin — Stages & Alternances' }) %>
<%- include('partials/nav', { activePage: 'admin' }) %>

<main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 flex-1 w-full space-y-8">

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-2 border-b border-gray-200">
    <div>
      <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">Gestion des annonces</h1>
      <p class="text-xs text-gray-500 mt-1">Gérez le catalogue, modifiez ou supprimez les offres d'emploi.</p>
    </div>

    <div class="flex items-center gap-3">
      <a href="/admin/offres/creer" class="bg-gray-900 hover:bg-gray-800 text-white text-xs font-medium px-3.5 py-2 rounded-lg shadow-sm flex items-center gap-1">
        <span>+</span> Ajouter une offre
      </a>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase">
            <th scope="col" class="py-3 px-5">ID</th>
            <th scope="col" class="py-3 px-5">Titre</th>
            <th scope="col" class="py-3 px-5">Entreprise</th>
            <th scope="col" class="py-3 px-5">Contrat</th>
            <th scope="col" class="py-3 px-5">Date</th>
            <th scope="col" class="py-3 px-5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% if (offers.length === 0) { %>
            <tr>
              <td colspan="6" class="py-8 text-center text-sm text-gray-500">
                Aucune offre disponible dans le catalogue.
              </td>
            </tr>
          <% } else { %>
            <% offers.forEach(offer => { %>
              <% const isStage = offer.type_contrat && offer.type_contrat.toLowerCase() === 'stage'; %>
              <% const isAlternance = offer.type_contrat && offer.type_contrat.toLowerCase() === 'alternance'; %>
              <tr class="hover:bg-gray-50/50">
                <td class="py-3.5 px-5 text-xs font-mono text-gray-400">#<%= offer.id %></td>
                <td class="py-3.5 px-5 font-semibold text-gray-900">
                  <a href="/offres/<%= offer.id %>" class="hover:underline"><%= offer.titre %></a>
                </td>
                <td class="py-3.5 px-5 text-gray-600"><%= offer.entreprise_nom %></td>
                <td class="py-3.5 px-5">
                  <span class="<%= isStage ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : (isAlternance ? 'bg-indigo-50 text-indigo-700 border-indigo-200' : 'bg-gray-100 text-gray-700 border-gray-200') %> border text-xs font-semibold px-2 py-0.5 rounded-full uppercase">
                    <%= offer.type_contrat %>
                  </span>
                </td>
                <td class="py-3.5 px-5 text-gray-500 text-xs">
                  <%= new Date(offer.date_publication).toLocaleDateString('fr-FR') %>
                </td>
                <td class="py-3.5 px-5 text-right space-x-2">
                  <a href="/admin/offres/editer/<%= offer.id %>" class="text-xs font-semibold text-blue-600 hover:text-blue-800">Modifier</a>
                  <form action="/admin/offres/supprimer/<%= offer.id %>" method="POST" onsubmit="return confirm('Etes-vous sur de vouloir supprimer cette offre ?');" class="inline">
                    <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 bg-transparent border-0 cursor-pointer p-0">Supprimer</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
