<%- include('partials/header', { title: offer.titre + ' — Détail de l\'offre' }) %>
<%- include('partials/nav', { activePage: 'offres' }) %>

<main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 flex-1 w-full space-y-6">

  <div>
    <a href="/" class="text-xs font-medium text-gray-500 hover:text-gray-900 inline-flex items-center gap-1">
      &larr; Retour au catalogue
    </a>
  </div>

  <% const isStage = offer.type_contrat && offer.type_contrat.toLowerCase() === 'stage'; %>
  <article class="bg-white border border-gray-200 rounded-xl p-6 md:p-8 shadow-sm space-y-6">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="<%= isStage ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-indigo-50 text-indigo-700 border-indigo-200' %> border text-xs font-semibold px-2.5 py-0.5 rounded-full uppercase">
            <%= offer.type_contrat %>
          </span>
          <span class="text-xs text-gray-400">Publié le <%= new Date(offer.date_publication).toLocaleDateString('fr-FR') %></span>
        </div>
        <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight"><%= offer.titre %></h1>
        <p class="text-sm text-gray-600 font-medium">
          <span class="text-gray-900 font-semibold"><%= offer.entreprise_nom %></span> • <%= offer.ville %>
        </p>
      </div>

      <div>
        <button id="btn-follow-detail" type="button" data-id="<%= offer.id %>" class="border border-gray-200 text-gray-700 hover:bg-rose-50 rounded-lg px-3.5 py-2 text-xs font-medium shadow-sm transition">
          Sauvegarder cette offre
        </button>
      </div>
    </div>

    <hr class="border-t border-gray-100">

    <% if (offer.technologies && offer.technologies.length > 0) { %>
      <section class="space-y-2">
        <h2 class="text-xs font-semibold text-gray-400 uppercase">Technologies requises</h2>
        <div class="flex flex-wrap gap-1.5">
          <% offer.technologies.forEach(tech => { %>
            <span class="bg-gray-100 border border-gray-200 text-gray-800 text-xs px-2.5 py-0.5 rounded"><%= tech.nom %></span>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section class="space-y-2">
      <h2 class="text-sm font-bold text-gray-900">Description de l'offre</h2>
      <p class="text-xs text-gray-600 leading-relaxed"><%= offer.description %></p>
    </section>

    <% if (offer.entreprise_description) { %>
      <section class="space-y-2">
        <h2 class="text-sm font-bold text-gray-900">À propos de <%= offer.entreprise_nom %></h2>
        <p class="text-xs text-gray-600 leading-relaxed"><%= offer.entreprise_description %></p>
      </section>
    <% } %>
  </article>

</main>

<script>
  const offerId = Number('<%= offer.id %>');

  function getFollowedOffers() {
    try {
      return JSON.parse(localStorage.getItem('followedOffers')) || [];
    } catch {
      return [];
    }
  }

  function updateButton() {
    const followed = getFollowedOffers();
    const isFollowed = followed.includes(offerId);
    const btn = document.getElementById('btn-follow-detail');
    if (btn) {
      btn.textContent = isFollowed ? 'Suivie' : 'Sauvegarder cette offre';
      btn.className = `border ${isFollowed ? 'bg-rose-50 text-rose-600 border-rose-200' : 'border-gray-200 text-gray-700 hover:bg-rose-50'} rounded-lg px-3.5 py-2 text-xs font-medium shadow-sm transition`;
    }
  }

  document.getElementById('btn-follow-detail')?.addEventListener('click', () => {
    let followed = getFollowedOffers();
    const index = followed.indexOf(offerId);
    if (index === -1) {
      followed.push(offerId);
    } else {
      followed.splice(index, 1);
    }
    localStorage.setItem('followedOffers', JSON.stringify(followed));
    updateButton();
  });

  updateButton();
</script>

<%- include('partials/footer') %>
