<%- include('partials/header', { title: 'Stages & Alternances — Catalogue' }) %>
<%- include('partials/nav', { activePage: 'offres' }) %>

<main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex-1 w-full space-y-6">

  <div class="text-center py-4 space-y-2">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">Trouvez votre Stage ou Alternance</h1>
    <p class="text-gray-600 text-sm md:text-base max-w-xl mx-auto">Consultez et filtrez les meilleures opportunités en développement web.</p>
  </div>

  <form action="/" method="GET" class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm grid grid-cols-1 md:grid-cols-12 gap-3">
    <input name="search" type="text" placeholder="Mots-clés (React, TechCorp...)" value="<%= query.search || '' %>" class="md:col-span-3 px-3.5 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:bg-white">
    
    <select name="contrat" class="md:col-span-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:bg-white">
      <option value="">Tous les contrats</option>
      <% contrats.forEach(c => { %>
        <option value="<%= c %>" <%= query.contrat === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>

    <select name="ville" class="md:col-span-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:bg-white">
      <option value="">Toutes les villes</option>
      <% villes.forEach(v => { %>
        <option value="<%= v %>" <%= query.ville === v ? 'selected' : '' %>><%= v %></option>
      <% }) %>
    </select>

    <select name="technologie" class="md:col-span-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:bg-white">
      <option value="">Toutes les techno</option>
      <% technologies.forEach(t => { %>
        <option value="<%= t.id %>" <%= query.technologie == t.id ? 'selected' : '' %>><%= t.nom %></option>
      <% }) %>
    </select>

    <select name="sort" class="md:col-span-2 px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 focus:bg-white">
      <option value="desc" <%= query.sort === 'desc' ? 'selected' : '' %>>Plus récents</option>
      <option value="asc" <%= query.sort === 'asc' ? 'selected' : '' %>>Plus anciens</option>
    </select>

    <button type="submit" class="md:col-span-1 bg-gray-900 text-white text-sm font-medium py-2 px-3 rounded-lg hover:bg-gray-800 transition">Filtrer</button>
  </form>

  <div class="flex items-center justify-between pt-2">
    <p class="text-sm font-semibold text-gray-700"><span class="text-gray-900 font-bold"><%= offers.length %></span> opportunités trouvées</p>
    <% if (query.search || query.contrat || query.ville || query.technologie || query.sort) { %>
      <a href="/" class="text-xs text-indigo-600 hover:underline">Réinitialiser les filtres</a>
    <% } %>
  </div>

  <% if (offers.length === 0) { %>
    <div class="bg-white border border-gray-200 rounded-xl p-8 text-center space-y-2">
      <p class="text-gray-500 text-sm">Aucune offre ne correspond à vos critères de recherche.</p>
      <a href="/" class="inline-block text-xs font-semibold text-indigo-600 hover:underline">Voir toutes les offres</a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <% offers.forEach(offer => { %>
        <% const isStage = offer.type_contrat && offer.type_contrat.toLowerCase() === 'stage'; %>
        <article class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="<%= isStage ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-indigo-50 text-indigo-700 border-indigo-200' %> border text-xs font-semibold px-2.5 py-0.5 rounded-full uppercase">
                <%= offer.type_contrat %>
              </span>
              <span class="text-xs text-gray-400">
                <%= new Date(offer.date_publication).toLocaleDateString('fr-FR') %>
              </span>
            </div>

            <div>
              <h2 class="text-lg font-bold text-gray-900 hover:text-indigo-600">
                <a href="/offres/<%= offer.id %>"><%= offer.titre %></a>
              </h2>
              <p class="text-xs text-gray-600 font-medium mt-1">
                <span class="text-gray-900 font-semibold"><%= offer.entreprise_nom %></span> • <%= offer.ville %>
              </p>
            </div>

            <p class="text-xs text-gray-600 line-clamp-2 leading-relaxed">
              <%= offer.description %>
            </p>

            <% if (offer.technologies && offer.technologies.length > 0) { %>
              <div class="flex flex-wrap gap-1.5 pt-1">
                <% offer.technologies.forEach(tech => { %>
                  <span class="bg-gray-100 border border-gray-200 text-gray-700 text-xs px-2 py-0.5 rounded"><%= tech.nom %></span>
                <% }) %>
              </div>
            <% } %>
          </div>

          <div class="pt-3 border-t border-gray-100 flex items-center justify-between">
            <a href="/offres/<%= offer.id %>" class="text-xs font-semibold text-indigo-600 hover:underline">
              Voir l'offre &rarr;
            </a>
            <button type="button" data-id="<%= offer.id %>" class="btn-follow border border-gray-200 text-gray-700 hover:bg-rose-50 rounded-lg px-2.5 py-1 text-xs font-medium transition">
              Sauvegarder
            </button>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>

</main>

<script>
  function getFollowedOffers() {
    try {
      return JSON.parse(localStorage.getItem('followedOffers')) || [];
    } catch {
      return [];
    }
  }

  function toggleFollow(id) {
    let followed = getFollowedOffers();
    const index = followed.indexOf(id);
    if (index === -1) {
      followed.push(id);
    } else {
      followed.splice(index, 1);
    }
    localStorage.setItem('followedOffers', JSON.stringify(followed));
    return followed.includes(id);
  }

  function updateButtons() {
    const followed = getFollowedOffers();
    document.querySelectorAll('.btn-follow').forEach(btn => {
      const id = Number(btn.dataset.id);
      const isFollowed = followed.includes(id);
      btn.textContent = isFollowed ? 'Suivie' : 'Sauvegarder';
      btn.className = `btn-follow border ${isFollowed ? 'bg-rose-50 text-rose-600 border-rose-200' : 'border-gray-200 text-gray-700 hover:bg-rose-50'} rounded-lg px-2.5 py-1 text-xs font-medium transition`;
    });
  }

  document.querySelectorAll('.btn-follow').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.id);
      toggleFollow(id);
      updateButtons();
    });
  });

  updateButtons();
</script>

<%- include('partials/footer') %>