<%- include('partials/header', { title: 'Mes Offres Suivies — Stages & Alternances' }) %>
<%- include('partials/nav', { activePage: 'suivies' }) %>

<main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 flex-1 w-full space-y-6">

  <div class="flex items-center justify-between border-b border-gray-200 pb-4">
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-extrabold text-gray-900 tracking-tight">Mes Offres Suivies</h1>
      <span id="followed-count" class="bg-gray-100 text-gray-800 text-xs font-bold px-2.5 py-0.5 rounded-full border border-gray-200">(0)</span>
    </div>
    <a href="/" class="text-xs font-medium text-gray-600 hover:text-gray-900">&larr; Explorer les offres</a>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase">
            <th scope="col" class="py-3.5 px-5">Poste</th>
            <th scope="col" class="py-3.5 px-5">Entreprise</th>
            <th scope="col" class="py-3.5 px-5">Type</th>
            <th scope="col" class="py-3.5 px-5 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="followed-list" class="divide-y divide-gray-100 text-sm">
          <tr>
            <td colspan="4" class="py-8 text-center text-gray-500 text-xs">Chargement...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</main>

<script>
  const allOffers = <%- JSON.stringify(offers) %>;

  function getFollowedOffers() {
    try {
      return JSON.parse(localStorage.getItem('followedOffers')) || [];
    } catch {
      return [];
    }
  }

  function removeFollowedOffer(id) {
    let followed = getFollowedOffers();
    followed = followed.filter(item => item !== id);
    localStorage.setItem('followedOffers', JSON.stringify(followed));
  }

  function renderFollowedOffers() {
    const tbody = document.getElementById('followed-list');
    const countEl = document.getElementById('followed-count');
    const followedIds = getFollowedOffers();

    countEl.textContent = `(${followedIds.length})`;

    if (followedIds.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="4" class="py-12 text-center text-gray-500 text-xs">
            Vous ne suivez aucune offre pour le moment.
            <br><a href="/" class="text-indigo-600 font-semibold hover:underline mt-1 inline-block">Découvrir les opportunités &rarr;</a>
          </td>
        </tr>
      `;
      return;
    }

    const followedOffers = allOffers.filter(o => followedIds.includes(o.id));

    tbody.innerHTML = followedOffers.map(offer => {
      const isStage = offer.type_contrat && offer.type_contrat.toLowerCase() === 'stage';
      return `
        <tr class="hover:bg-gray-50/50">
          <td class="py-3.5 px-5 font-semibold text-gray-900">
            <a href="/offres/${offer.id}" class="hover:underline">${offer.titre}</a>
          </td>
          <td class="py-3.5 px-5 text-gray-600">${offer.entreprise_nom} (${offer.ville})</td>
          <td class="py-3.5 px-5">
            <span class="${isStage ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-indigo-50 text-indigo-700 border-indigo-200'} border text-xs font-semibold px-2 py-0.5 rounded-full uppercase">
              ${offer.type_contrat}
            </span>
          </td>
          <td class="py-3.5 px-5 text-right">
            <button type="button" data-id="${offer.id}" class="btn-remove-follow text-xs font-medium text-red-600 hover:text-red-800 border border-red-200 hover:bg-red-50 px-3 py-1 rounded-lg transition">
              Retirer
            </button>
          </td>
        </tr>
      `;
    }).join('');

    document.querySelectorAll('.btn-remove-follow').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = Number(e.target.dataset.id);
        removeFollowedOffer(id);
        renderFollowedOffers();
      });
    });
  }

  renderFollowedOffers();
</script>

<%- include('partials/footer') %>
